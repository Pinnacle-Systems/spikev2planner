generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["clientExtensions"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Orders {
  id                        Int                         @id @default(autoincrement())
  orderNo                   String
  buyer                     String?
  dDate                     DateTime                    @db.Date
  style                     String?
  quantity                  Int?
  sam                       String?
  styleType                 String                      @default("basic")
  lines                     OrderLines[]
  OrderSizeColorWiseDetails OrderSizeColorWiseDetails[]
  PrevOrder                 Orders?                     @relation("Replan", fields: [prevOrdersId], references: [id])
  prevOrdersId              Int?                        @unique
  Orders                    Orders?                     @relation("Replan")
  version                   Int?                        @default(1)
  createdAt                 DateTime?                   @default(now())
  updatedAt                 DateTime?                   @updatedAt
}

model OrderSizeColorWiseDetails {
  id       Int    @id @default(autoincrement())
  Order    Orders @relation(fields: [ordersId], references: [id], onDelete: Cascade)
  ordersId Int
  size     String
  color    String
  qty      Int
}

model ProductionDetails {
  id           Int       @id @default(autoincrement())
  date         DateTime  @default(now())
  orderNo      String
  size         String
  color        String
  line         String
  qty          Int
  deliveryDate DateTime? @db.Date
}

model OrderLines {
  id                 Int                  @id @default(autoincrement())
  Line               Line                 @relation(fields: [lineId], references: [id])
  lineId             Int
  Orders             Orders               @relation(fields: [ordersId], references: [id], onDelete: Cascade)
  ordersId           Int
  pcs                Int
  startDate          DateTime             @db.Date
  endDate            DateTime             @db.Date
  days               Int
  efficiency         Int?                 @default(0)
  capacity           Int?                 @default(0)
  learningCurveItems LearningCurveItems[]
}

model LearningCurveItems {
  id           Int        @id @default(autoincrement())
  OrderLines   OrderLines @relation(fields: [orderLinesId], references: [id], onDelete: Cascade)
  orderLinesId Int
  percentage   Float      @default(0)
}

model Unit {
  id       Int     @id @default(autoincrement())
  name     String?
  location String?
  line     Line[]
}

model Line {
  id         Int          @id @default(autoincrement())
  Unit       Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId     Int
  styleType  String       @default("basic")
  name       String?
  inCharge   String?
  capacity   Int?
  efficiency Int?
  OrderLines OrderLines[]
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  description String?
}

model TimeAndAction {
  id      Int       @id @default(autoincrement())
  orderNo String
  fetdt   DateTime? @db.Date
  fcDate  DateTime? @db.Date
  fQty    Float     @default(0)
  fcQty   Float     @default(0)
  fPer    Float     @default(0)
  fDays   Float     @default(0)
  tetdt   DateTime? @db.Date
  tcDate  DateTime? @db.Date
  tQty    Float     @default(0)
  tcQty   Float     @default(0)
  tPer    Float     @default(0)
  tDays   Float     @default(0)
}

model Company {
  id            Int            @id @default(autoincrement())
  companyId     String         @unique @default(uuid())
  name          String
  code          String?
  gstNo         String?
  panNo         String?
  contactName   String?
  contactMobile BigInt
  contactEmail  String?
  bankName      String?
  accNo         String?
  branchName    String?
  ifscCode      String?
  branch        Branch[]
  Role          Role[]
  finYear       FinYear[]
  Subscription  Subscription[]
}

model Branch {
  id             Int            @id @default(autoincrement())
  branchName     String
  branchCode     String?
  contactName    String?
  contactMobile  BigInt
  contactEmail   String?
  company        Company        @relation(fields: [companyId], references: [id])
  companyId      Int
  active         Boolean        @default(true)
  // EmployeeCategory                   EmployeeCategory[]
  UserOnBranch   UserOnBranch[]
  Employee       Employee[]
  idPrefix       String?
  idSequence     String?
  tempPrefix     String?
  tempSequence   String?
  prefixCategory String?
  address        String?
  gstNo          String?
  panNo          String?
  logo           String?
}

model FinYear {
  id        Int      @id @default(autoincrement())
  from      DateTime
  to        DateTime
  Company   Company? @relation(fields: [companyId], references: [id])
  companyId Int?
  active    Boolean  @default(true)
}

model Subscription {
  id        Int      @id @default(autoincrement())
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int
  validFrom DateTime
  expireAt  DateTime
  code      String
  maxUsers  Int
}

model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  email        String?
  Employee     Employee?      @relation(fields: [employeeId], references: [id])
  password     String
  role         Role?          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       Int?
  otp          String?
  active       Boolean        @default(true)
  UserOnBranch UserOnBranch[]
  employeeId   Int?
}

model UserOnBranch {
  id       Int    @id @default(autoincrement())
  Branch   Branch @relation(fields: [branchId], references: [id])
  branchId Int
  User     User   @relation(fields: [userId], references: [id])
  userId   Int
}

model Employee {
  id        Int     @id @default(autoincrement())
  name      String?
  email     String? @unique
  regNo     String? @unique
  chamberNo String?
  User      User[]
  branch    Branch? @relation(fields: [branchId], references: [id])
  branchId  Int?
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   Int
  User        User[]
  RoleOnPage  RoleOnPage[]
  active      Boolean      @default(true)
  defaultRole Boolean      @default(false)

  @@unique([companyId, name])
}

model RoleOnPage {
  id     Int     @id @default(autoincrement())
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId Int
  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId Int
  read   Boolean @default(false)
  create Boolean @default(false)
  edit   Boolean @default(false)
  delete Boolean @default(false)

  @@unique([roleId, pageId])
}

model PageGroup {
  id     Int     @id @default(autoincrement())
  type   String?
  name   String
  active Boolean @default(true)
  Page   Page[]
}

model Page {
  id          Int          @id @default(autoincrement())
  name        String
  link        String?
  type        String?
  active      Boolean      @default(true)
  PageGroup   PageGroup?   @relation(fields: [pageGroupId], references: [id])
  pageGroupId Int?
  RoleOnPage  RoleOnPage[]
}
